# ---------------------------------------------------------------------------
# PUBLIC — these are compiled into the client bundle by Vite. Never put a secret here.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_APF_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_APF_POLICY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ACTIVE_CHAIN=arbitrum
VITE_THIRDWEB_CLIENT_ID=your_client_id_here
VITE_WP_API_URL=https://piratefederation.org/wp-json
VITE_CF_ANALYTICS_TOKEN=your_cloudflare_web_analytics_token_here

# ---------------------------------------------------------------------------
# SERVER-ONLY — set these in the Cloudflare Pages dashboard (Settings > Variables),
# never in a `.env` that Vite can read into the bundle.
# The VITE_ prefix is what exposes a value to the browser; anything below must not have it.
#
#   STRIPE_SECRET_KEY            Stripe secret key for /api/donate       (Stripe -> APF Action)
#   EMAILIT_API_KEY              Emailit key for /api/subscribe
#   AI_GATEWAY_URL               Upstream LLM gateway URL for /api/ai
#   AI_API_SECRET                Bearer token for the AI gateway
#   AI_MODEL                     Optional model identifier passed through
#   SUPABASE_SERVICE_ROLE_KEY    Server-side Supabase writes only. Bypasses RLS.
#   SITE_URL                     e.g. https://pirateusa.org — used to build Stripe
#                                success/cancel redirect URLs. Defaults to pirateusa.org.
# ---------------------------------------------------------------------------
